# Athenaeum / BiblioBox — Backend Environment Configuration

# PostgreSQL Database Connection
# Example for Managed Cloud PostgreSQL (Neon / Supabase / Render / Railway):
# DATABASE_URL=postgresql+psycopg2://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local SQLite fallback for development if cloud database is not yet linked:
DATABASE_URL=sqlite:///./library.db

# JWT Authentication Secrets
JWT_SECRET_KEY=athenaeum_super_secure_jwt_secret_change_in_production_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed Frontend Origins (CORS)
# FRONTEND_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# REAL SMS GATEWAY SETTINGS FOR MOBILE OTP
# ─────────────────────────────────────────────────────────────────────────────
# To receive OTPs directly on your real mobile phone number, configure ONE of
# the providers below. If left empty, the application runs in development sandbox mode
# and displays the OTP on screen and in the server logs so testing is never blocked.

# OPTION 1: Fast2SMS (Recommended for India - https://www.fast2sms.com)
# Sign up and get your free/quick API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=

# OPTION 2: Twilio (Global SMS - https://www.twilio.com)
# Get your Account SID, Auth Token, and Twilio phone number from Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OPTION 3: 2Factor.in (India Transactional SMS - https://2factor.in)
TWO_FACTOR_API_KEY=

# OPTION 4: Custom SMS Webhook
# POSTs JSON {"phone": "+91...", "otp": "123456", "message": "..."} to this URL
SMS_WEBHOOK_URL=
